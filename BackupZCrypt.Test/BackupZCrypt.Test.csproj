<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      xUnit v3 test projects are self-executing console applications: the runner is linked into the
      assembly instead of loading it, so the project has to produce an executable. The generated
      entry point comes from xunit.v3, not from Microsoft.NET.Test.Sdk.
    -->
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <!-- The xunit.v3 metapackage already carries xunit.analyzers, so it is not referenced twice. -->
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="NSubstitute" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BackupZCrypt.Domain\BackupZCrypt.Domain.csproj" />
    <ProjectReference Include="..\BackupZCrypt.Application\BackupZCrypt.Application.csproj" />
    <ProjectReference Include="..\BackupZCrypt.Infrastructure\BackupZCrypt.Infrastructure.csproj" />
    <ProjectReference Include="..\BackupZCrypt.Composition\BackupZCrypt.Composition.csproj" />
    <ProjectReference Include="..\BackupZCrypt.Desktop\BackupZCrypt.Desktop.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\BackupZCrypt.Desktop\Resources\Strings.resx" Link="TestData\Strings.resx" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\BackupZCrypt.Desktop\Resources\Strings.es.resx" Link="TestData\Strings.es.resx" CopyToOutputDirectory="PreserveNewest" />
    <None Include="TestData\OnDiskFormatArchives\**\*" LinkBase="TestData\OnDiskFormatArchives" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
