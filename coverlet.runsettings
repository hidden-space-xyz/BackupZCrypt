<?xml version="1.0" encoding="utf-8"?>
<!--
  Coverage settings, applied by passing this file through the "settings" option of `dotnet test`.

  Everything excluded below is code that cannot be exercised without standing up a real Avalonia
  render platform and window, which neither a developer machine nor a GitHub Actions runner has.
  Testing it would mean asserting that a framework call was made against a mock of the framework,
  which produces a passing test that can never fail for a real reason. The exclusions are listed
  one per line, each with the reason it is not unit-testable, so the denominator reflects code that
  a test could genuinely protect.

  Nothing below the Desktop layer is excluded: Domain, Application, Infrastructure and Composition
  are measured in full, and that is where every cryptographic and data-integrity guarantee lives.
-->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <Format>cobertura</Format>
          <Exclude>
            <!-- .axaml.cs code-behind: constructed only by the XAML loader against a live visual tree. -->
            [BackupZCrypt]BackupZCrypt.Desktop.Views.*,
            <!-- Compiled XAML, generated by the Avalonia build task; not hand-written source. -->
            [BackupZCrypt]CompiledAvaloniaXaml.*,
            [BackupZCrypt]*XamlClosure*,
            <!-- Process entry point and Avalonia bootstrap: starting them starts a real UI. -->
            [BackupZCrypt]BackupZCrypt.Desktop.Program,
            [BackupZCrypt]BackupZCrypt.Desktop.App,
            <!-- StreamGeometry.Parse throws without IPlatformRenderInterface (verified empirically). -->
            [BackupZCrypt]BackupZCrypt.Desktop.Icons,
            <!-- Resolves a View type for a ViewModel by reflection; needs the view types above. -->
            [BackupZCrypt]BackupZCrypt.Desktop.ViewLocator,
            <!-- Platform adapters: both need a live TopLevel/ApplicationLifetime, and their entire
                 body is a single framework call, so a test could only assert that Avalonia was called. -->
            [BackupZCrypt]BackupZCrypt.Desktop.Services.FilePickerService,
            [BackupZCrypt]BackupZCrypt.Desktop.Services.ClipboardService
          </Exclude>
          <!--
            Deliberately does NOT list CompilerGeneratedAttribute. That attribute sits on every async
            state machine and lambda closure, so excluding it would silently drop the error and
            cancellation paths of the backup engine out of the denominator and inflate the result.
            Only genuinely generated source is excluded here.
          -->
          <ExcludeByAttribute>GeneratedCodeAttribute,ExcludeFromCodeCoverageAttribute</ExcludeByAttribute>
          <SingleHit>false</SingleHit>
          <UseSourceLink>false</UseSourceLink>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
