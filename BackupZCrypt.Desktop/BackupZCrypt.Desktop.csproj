<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NeutralLanguage>en</NeutralLanguage>
    <AnalysisLevel>latest</AnalysisLevel>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BackupZCrypt.Application\BackupZCrypt.Application.csproj" />
    <ProjectReference Include="..\BackupZCrypt.Composition\BackupZCrypt.Composition.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Resources\Strings.es.resx">
      <DependentUpon>Strings.resx</DependentUpon>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Resources\CloudZCrypt.png" />
  </ItemGroup>

  <PropertyGroup>
    <PortableOutputRoot>$(MSBuildThisFileDirectory)..\dist</PortableOutputRoot>
  </PropertyGroup>

  <ItemGroup>
    <PortableRuntimeIdentifier Include="win-x64" />
    <PortableRuntimeIdentifier Include="linux-x64" />
    <PortableRuntimeIdentifier Include="osx-x64" />
    <PortableRuntimeIdentifier Include="osx-arm64" />
  </ItemGroup>

  <Target Name="GeneratePortablePackages"
          AfterTargets="Build"
          Condition="'$(Configuration)' == 'Release' and '$(BuildingPortablePackage)' != 'true' and '$(DesignTimeBuild)' != 'true' and '$(BuildingForLiveUnitTesting)' != 'true'">
    <Message Importance="high"
             Text="Building portable self-contained package(s) for: @(PortableRuntimeIdentifier)" />
    <Exec Command="dotnet publish &quot;$(MSBuildThisFileFullPath)&quot; -c $(Configuration) -r %(PortableRuntimeIdentifier.Identity) --self-contained true --nologo -p:PublishSingleFile=true -p:IncludeNativeLibrariesForSelfExtract=true -p:EnableCompressionInSingleFile=true -p:DebugType=embedded -p:BuildingPortablePackage=true -o &quot;$(PortableOutputRoot)\portable-%(PortableRuntimeIdentifier.Identity)&quot;" />
    <ItemGroup>
      <_PortableLeftoverSymbols Include="$(PortableOutputRoot)\**\*.pdb" />
    </ItemGroup>
    <Delete Files="@(_PortableLeftoverSymbols)" />
    <Message Importance="high"
             Text="Portable package ready: $(PortableOutputRoot)\portable-%(PortableRuntimeIdentifier.Identity)" />
  </Target>
</Project>
