<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BackupZCrypt.Desktop.ViewModels"
             xmlns:views="using:BackupZCrypt.Desktop.Views"
             xmlns:res="using:BackupZCrypt.Desktop.Resources"
             xmlns:local="using:BackupZCrypt.Desktop"
             x:Class="BackupZCrypt.Desktop.Views.UpdateBackupView"
             x:DataType="vm:UpdateBackupViewModel">

  <Grid RowDefinitions="*,Auto">
    <ScrollViewer Grid.Row="0">
      <StackPanel Margin="40,28,40,32" Spacing="16" MaxWidth="820">

        <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,8">
          <Border Grid.Column="0" Classes="pageIcon">
            <PathIcon Data="{x:Static local:Icons.ArrowSync}" />
          </Border>
          <StackPanel Grid.Column="1" Margin="16,0,0,0" Spacing="4" VerticalAlignment="Center">
            <TextBlock Classes="h1" Text="{x:Static res:Strings.UpdateTitle}" />
            <TextBlock Classes="subtitle" Text="{x:Static res:Strings.UpdateSubtitle}" />
          </StackPanel>
        </Grid>

        <Border Classes="card">
          <StackPanel Spacing="18">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Border Classes="stepBadge">
                <TextBlock Text="1" />
              </Border>
              <TextBlock Classes="cardTitle" Text="{x:Static res:Strings.SectionLocations}" />
            </StackPanel>

            <StackPanel Spacing="8">
              <TextBlock Classes="label" Text="{x:Static res:Strings.SourceLabel}" />
              <TextBox Classes="field"
                       Text="{Binding SourcePath}"
                       PlaceholderText="{x:Static res:Strings.UpdateSourceHint}">
                <TextBox.InnerRightContent>
                  <StackPanel Classes="fieldActions">
                    <Button Classes="ghost"
                            ToolTip.Tip="{x:Static res:Strings.PickFolderTitle}"
                            AutomationProperties.Name="{x:Static res:Strings.PickFolderTitle}"
                            Command="{Binding PickSourceFolderCommand}">
                      <PathIcon Data="{x:Static local:Icons.FolderOpen}" />
                    </Button>
                  </StackPanel>
                </TextBox.InnerRightContent>
              </TextBox>
            </StackPanel>

            <StackPanel Spacing="8">
              <TextBlock Classes="label" Text="{x:Static res:Strings.BackupLabel}" />
              <TextBox Classes="field"
                       Text="{Binding DestinationPath}"
                       PlaceholderText="{x:Static res:Strings.BackupHint}">
                <TextBox.InnerRightContent>
                  <StackPanel Classes="fieldActions">
                    <Button Classes="ghost"
                            ToolTip.Tip="{x:Static res:Strings.PickFolderTitle}"
                            AutomationProperties.Name="{x:Static res:Strings.PickFolderTitle}"
                            Command="{Binding PickBackupFolderCommand}">
                      <PathIcon Data="{x:Static local:Icons.FolderOpen}" />
                    </Button>
                  </StackPanel>
                </TextBox.InnerRightContent>
              </TextBox>
            </StackPanel>

            <Border Classes="notice success reveal" IsVisible="{Binding IsBackupDetected}">
              <Grid ColumnDefinitions="Auto,*">
                <PathIcon Grid.Column="0" Data="{x:Static local:Icons.CheckCircle}" />
                <TextBlock Grid.Column="1" Text="{x:Static res:Strings.DetectFound}" />
              </Grid>
            </Border>

            <Border Classes="notice warning reveal" IsVisible="{Binding HasDetection}">
              <Grid ColumnDefinitions="Auto,*">
                <PathIcon Grid.Column="0" Data="{x:Static local:Icons.Warning}" />
                <TextBlock Grid.Column="1" Text="{x:Static res:Strings.DetectMissing}" />
              </Grid>
            </Border>
          </StackPanel>
        </Border>

        <Border Classes="card reveal" IsVisible="{Binding IsBackupDetected}">
          <StackPanel Spacing="18">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Border Classes="stepBadge">
                <TextBlock Text="2" />
              </Border>
              <TextBlock Classes="cardTitle" Text="{x:Static res:Strings.SectionSecurity}" />
            </StackPanel>
            <StackPanel Spacing="8">
              <TextBlock Classes="label" Text="{x:Static res:Strings.PasswordLabel}" />
              <TextBox Classes="field"
                       Text="{Binding Password}"
                       PasswordChar="●"
                       PlaceholderText="{x:Static res:Strings.BackupPasswordHint}">
                <TextBox.InnerRightContent>
                  <StackPanel Classes="fieldActions">
                    <ToggleButton Classes="ghost"
                                  IsChecked="{Binding $parent[TextBox].RevealPassword}"
                                  ToolTip.Tip="{x:Static res:Strings.RevealPasswordTooltip}"
                                  AutomationProperties.Name="{x:Static res:Strings.RevealPasswordTooltip}">
                      <PathIcon Data="{x:Static local:Icons.Eye}" />
                    </ToggleButton>
                  </StackPanel>
                </TextBox.InnerRightContent>
              </TextBox>
            </StackPanel>
          </StackPanel>
        </Border>

        <views:OperationStatusView />
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="1" Classes="actionBar">
      <Grid MaxWidth="820" ColumnDefinitions="*,Auto">
        <Button Grid.Column="1"
                Classes="primary"
                IsDefault="{Binding IsActivePage}"
                Command="{Binding StartCommand}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <PathIcon Data="{x:Static local:Icons.ArrowSync}" />
            <TextBlock Text="{x:Static res:Strings.StartUpdate}" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </Grid>
    </Border>
  </Grid>
</UserControl>
