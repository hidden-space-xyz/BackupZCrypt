<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BackupZCrypt.Desktop.ViewModels"
             xmlns:views="using:BackupZCrypt.Desktop.Views"
             xmlns:res="using:BackupZCrypt.Desktop.Resources"
             x:Class="BackupZCrypt.Desktop.Views.UpdateBackupView"
             x:DataType="vm:UpdateBackupViewModel">

  <ScrollViewer>
    <StackPanel Margin="40,32,40,40" Spacing="20" MaxWidth="860">

      <StackPanel Spacing="6">
        <TextBlock Classes="h1" Text="{x:Static res:Strings.UpdateTitle}" />
        <TextBlock Classes="subtitle" Text="{x:Static res:Strings.UpdateSubtitle}" />
      </StackPanel>

      <Border Classes="card">
        <StackPanel Spacing="16">
          <TextBlock Classes="section" Text="{x:Static res:Strings.SectionLocations}" />

          <StackPanel Spacing="6">
            <TextBlock Classes="label" Text="{x:Static res:Strings.SourceLabel}" />
            <Grid ColumnDefinitions="*,Auto">
              <TextBox Grid.Column="0"
                       Classes="field"
                       Text="{Binding SourcePath}"
                       Watermark="{x:Static res:Strings.UpdateSourceHint}" />
              <Button Grid.Column="1"
                      Margin="8,0,0,0"
                      Content="{x:Static res:Strings.BrowseFolder}"
                      Command="{Binding PickSourceFolderCommand}" />
            </Grid>
          </StackPanel>

          <StackPanel Spacing="6">
            <TextBlock Classes="label" Text="{x:Static res:Strings.BackupLabel}" />
            <Grid ColumnDefinitions="*,Auto">
              <TextBox Grid.Column="0"
                       Classes="field"
                       Text="{Binding DestinationPath}"
                       Watermark="{x:Static res:Strings.BackupHint}" />
              <Button Grid.Column="1"
                      Margin="8,0,0,0"
                      Content="{x:Static res:Strings.BrowseFolder}"
                      Command="{Binding PickBackupFolderCommand}" />
            </Grid>
          </StackPanel>

          <!-- Backup detection banner -->
          <StackPanel Orientation="Horizontal"
                      Spacing="10"
                      IsVisible="{Binding HasDetection}">
            <TextBlock Text="{Binding DetectionIcon}" FontSize="14" />
            <TextBlock Text="{Binding DetectionMessage}"
                       TextWrapping="Wrap"
                       FontSize="13"
                       Foreground="{Binding DetectionBrush}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Classes="card" IsVisible="{Binding IsPasswordRequired}">
        <StackPanel Spacing="16">
          <TextBlock Classes="section" Text="{x:Static res:Strings.SectionSecurity}" />
          <StackPanel Spacing="6">
            <TextBlock Classes="label" Text="{x:Static res:Strings.PasswordLabel}" />
            <TextBox Classes="field"
                     Text="{Binding Password}"
                     PasswordChar="●"
                     Watermark="{x:Static res:Strings.PasswordHint}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <Button Classes="primary"
              HorizontalAlignment="Left"
              Content="{x:Static res:Strings.StartUpdate}"
              Command="{Binding StartCommand}" />

      <views:OperationStatusView />
    </StackPanel>
  </ScrollViewer>
</UserControl>
