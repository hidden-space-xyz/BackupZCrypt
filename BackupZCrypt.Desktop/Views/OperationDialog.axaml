<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BackupZCrypt.Desktop.ViewModels"
             xmlns:views="using:BackupZCrypt.Desktop.Views"
             xmlns:res="using:BackupZCrypt.Desktop.Resources"
             xmlns:local="using:BackupZCrypt.Desktop"
             x:Class="BackupZCrypt.Desktop.Views.OperationDialog"
             x:DataType="vm:OperationViewModelBase">

  <UserControl.Styles>
    <Style Selector="views|OperationDialog Border#Scrim">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.24" Easing="0.25,0.1,0.25,1" />
        </Transitions>
      </Setter>
    </Style>

    <Style Selector="views|OperationDialog Border#Card">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="RenderTransform" Value="translateY(20px) scale(0.97)" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.22" Easing="0.2,0,0,1" />
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.42" Easing="0.16,1,0.3,1" />
        </Transitions>
      </Setter>
    </Style>

    <Style Selector="views|OperationDialog.open Border#Scrim">
      <Setter Property="Opacity" Value="1" />
    </Style>

    <Style Selector="views|OperationDialog.open Border#Card">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="RenderTransform" Value="translateY(0px) scale(1)" />
    </Style>

    <Style Selector="views|OperationDialog.closing Border#Scrim">
      <Setter Property="Opacity" Value="0" />
    </Style>

    <Style Selector="views|OperationDialog.closing Border#Card">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="RenderTransform" Value="translateY(10px) scale(0.98)" />
    </Style>

    <Style Selector="Border.statusBadge">
      <Setter Property="Width" Value="40" />
      <Setter Property="Height" Value="40" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="Border.statusBadge PathIcon">
      <Setter Property="Width" Value="20" />
      <Setter Property="Height" Value="20" />
    </Style>

    <Style Selector="Border.statusBadge.warning">
      <Setter Property="Background" Value="{StaticResource WarningTintBrush}" />
    </Style>

    <Style Selector="Border.statusBadge.warning PathIcon">
      <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
    </Style>

    <Style Selector="Border.resultBadge">
      <Setter Property="Width" Value="64" />
      <Setter Property="Height" Value="64" />
      <Setter Property="CornerRadius" Value="32" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <Style Selector="Border.resultBadge PathIcon">
      <Setter Property="Width" Value="32" />
      <Setter Property="Height" Value="32" />
    </Style>

    <Style Selector="Border.resultBadge.success">
      <Setter Property="Background" Value="{StaticResource SuccessTintBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource SuccessOutlineBrush}" />
    </Style>

    <Style Selector="Border.resultBadge.success PathIcon">
      <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
    </Style>

    <Style Selector="Border.resultBadge.danger">
      <Setter Property="Background" Value="{StaticResource DangerTintBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource DangerOutlineBrush}" />
    </Style>

    <Style Selector="Border.resultBadge.danger PathIcon">
      <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
    </Style>

    <Style Selector="Border.resultStats">
      <Setter Property="Background" Value="{StaticResource FieldBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="16,14" />
    </Style>

    <Style Selector="Border.resultStats PathIcon">
      <Setter Property="Width" Value="16" />
      <Setter Property="Height" Value="16" />
      <Setter Property="Margin" Value="0,0,12,0" />
      <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="Border.resultStats TextBlock">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontFeatures" Value="+tnum" />
      <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style Selector="ItemsControl.messages TextBlock">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="LineHeight" Value="19" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
  </UserControl.Styles>

  <Panel>
    <Border x:Name="Scrim"
            Background="{StaticResource ScrimBrush}"
            PointerPressed="OnScrimPressed" />

    <Border x:Name="Card"
            Width="460"
            Margin="24"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="{StaticResource RaisedBackgroundBrush}"
            BorderBrush="{StaticResource CardOutlineBrush}"
            BorderThickness="1"
            CornerRadius="16"
            Padding="28"
            BoxShadow="{StaticResource DialogShadow}"
            Focusable="True"
            KeyboardNavigation.TabNavigation="Cycle">
      <Panel>

        <StackPanel x:Name="RunningPanel" Classes="reveal" Spacing="18" IsVisible="False">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <Panel Grid.Column="0" Width="22" Height="22" VerticalAlignment="Center">
              <Ellipse Classes="spinnerTrack" />
              <Arc Classes="spinner">
                <Arc.RenderTransform>
                  <RotateTransform />
                </Arc.RenderTransform>
              </Arc>
            </Panel>
            <TextBlock Grid.Column="1"
                       Classes="cardTitle"
                       FontSize="16"
                       Margin="12,0,12,0"
                       Text="{x:Static res:Strings.ProgressTitle}" />
            <TextBlock Grid.Column="2"
                       Classes="numeric"
                       FontSize="22"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource PrimaryTextBrush}"
                       IsVisible="{Binding !IsProgressIndeterminate}"
                       Text="{Binding ProgressValue, StringFormat={}{0:0}%}" />
          </Grid>

          <ProgressBar Minimum="0"
                       Maximum="100"
                       IsIndeterminate="{Binding IsProgressIndeterminate}"
                       Value="{Binding ProgressValue}" />

          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
            <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
              <TextBlock Classes="label numeric" Text="{Binding ProgressText}" />
              <TextBlock Classes="caption numeric" Text="{Binding ElapsedText}" />
            </StackPanel>
            <Button Grid.Column="1"
                    Classes="secondary"
                    VerticalAlignment="Center"
                    Content="{x:Static res:Strings.CancelButton}"
                    Command="{Binding CancelOperationCommand}" />
          </Grid>
        </StackPanel>

        <StackPanel x:Name="WarningsPanel" Classes="reveal" Spacing="18" IsVisible="False">
          <StackPanel Orientation="Horizontal" Spacing="12">
            <Border Classes="statusBadge warning">
              <PathIcon Data="{x:Static local:Icons.Warning}" />
            </Border>
            <TextBlock Classes="cardTitle"
                       FontSize="16"
                       Text="{x:Static res:Strings.WarningsTitle}" />
          </StackPanel>

          <Border Classes="notice warning" Padding="14,10">
            <ScrollViewer MaxHeight="260">
              <ItemsControl Classes="messages" ItemsSource="{Binding Warnings}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="x:String">
                    <Grid ColumnDefinitions="Auto,*" Margin="0,3">
                      <Ellipse Grid.Column="0"
                               Width="5" Height="5"
                               Margin="0,7,10,0"
                               VerticalAlignment="Top"
                               Fill="{StaticResource WarningBrush}" />
                      <TextBlock Grid.Column="1"
                                 Foreground="{StaticResource PrimaryTextBrush}"
                                 Text="{Binding}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Border>

          <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
            <Button Classes="secondary"
                    Content="{x:Static res:Strings.DismissButton}"
                    Command="{Binding DismissWarningsCommand}" />
            <Button Classes="primary"
                    Content="{x:Static res:Strings.ContinueAnyway}"
                    Command="{Binding ContinueAnywayCommand}" />
          </StackPanel>
        </StackPanel>

        <StackPanel x:Name="ResultPanel" Classes="reveal" Spacing="20" IsVisible="False">
          <StackPanel Spacing="14">
            <Panel HorizontalAlignment="Center">
              <Border Classes="resultBadge success" IsVisible="{Binding ResultIsSuccess}">
                <PathIcon Data="{x:Static local:Icons.CheckCircle}" />
              </Border>
              <Border Classes="resultBadge danger" IsVisible="{Binding !ResultIsSuccess}">
                <PathIcon Data="{x:Static local:Icons.ErrorCircle}" />
              </Border>
            </Panel>
            <TextBlock HorizontalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource PrimaryTextBrush}"
                       Text="{Binding ResultTitle}" />
          </StackPanel>

          <Border Classes="resultStats" IsVisible="{Binding HasResultDetails}">
            <StackPanel Spacing="12">
              <Grid ColumnDefinitions="Auto,*">
                <PathIcon Grid.Column="0" Data="{x:Static local:Icons.Document}" />
                <TextBlock Grid.Column="1" Text="{Binding ResultFiles}" />
              </Grid>
              <Grid ColumnDefinitions="Auto,*">
                <PathIcon Grid.Column="0" Data="{x:Static local:Icons.Clock}" />
                <TextBlock Grid.Column="1" Text="{Binding ResultDuration}" />
              </Grid>
              <Grid ColumnDefinitions="Auto,*">
                <PathIcon Grid.Column="0" Data="{x:Static local:Icons.Database}" />
                <TextBlock Grid.Column="1" Text="{Binding ResultSize}" />
              </Grid>
            </StackPanel>
          </Border>

          <Border Classes="notice danger" Padding="14,10" IsVisible="{Binding ShowErrors}">
            <ScrollViewer MaxHeight="200">
              <ItemsControl Classes="messages" ItemsSource="{Binding Errors}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="x:String">
                    <Grid ColumnDefinitions="Auto,*" Margin="0,3">
                      <Ellipse Grid.Column="0"
                               Width="5" Height="5"
                               Margin="0,7,10,0"
                               VerticalAlignment="Top"
                               Fill="{StaticResource DangerBrush}" />
                      <TextBlock Grid.Column="1"
                                 Foreground="{StaticResource PrimaryTextBrush}"
                                 Text="{Binding}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Border>

          <Button Classes.primary="{Binding ResultIsSuccess}"
                  Classes.secondary="{Binding !ResultIsSuccess}"
                  HorizontalAlignment="Stretch"
                  Content="{x:Static res:Strings.CloseButton}"
                  Command="{Binding DismissResultCommand}" />
        </StackPanel>
      </Panel>
    </Border>
  </Panel>
</UserControl>
