<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BackupZCrypt.Desktop.ViewModels"
             xmlns:views="using:BackupZCrypt.Desktop.Views"
             xmlns:res="using:BackupZCrypt.Desktop.Resources"
             xmlns:conv="using:BackupZCrypt.Desktop.Converters"
             xmlns:local="using:BackupZCrypt.Desktop"
             x:Class="BackupZCrypt.Desktop.Views.CreateBackupView"
             x:DataType="vm:CreateBackupViewModel">

  <Grid RowDefinitions="*,Auto">
    <ScrollViewer Grid.Row="0">
      <StackPanel Margin="40,28,40,32" Spacing="16" MaxWidth="820">

        <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,8">
          <Border Grid.Column="0" Classes="pageIcon">
            <PathIcon Data="{x:Static local:Icons.ShieldLock}" />
          </Border>
          <StackPanel Grid.Column="1" Margin="16,0,0,0" Spacing="4" VerticalAlignment="Center">
            <TextBlock Classes="h1" Text="{x:Static res:Strings.CreateTitle}" />
            <TextBlock Classes="subtitle" Text="{x:Static res:Strings.CreateSubtitle}" />
          </StackPanel>
        </Grid>

        <Border Classes="card">
          <StackPanel Spacing="18">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Border Classes="stepBadge">
                <TextBlock Text="1" />
              </Border>
              <TextBlock Classes="cardTitle" Text="{x:Static res:Strings.SectionLocations}" />
            </StackPanel>

            <StackPanel Spacing="8">
              <TextBlock Classes="label" Text="{x:Static res:Strings.SourceLabel}" />
              <TextBox Classes="field"
                       Text="{Binding SourcePath}"
                       PlaceholderText="{x:Static res:Strings.SourceHint}">
                <TextBox.InnerRightContent>
                  <StackPanel Classes="fieldActions">
                    <Button Classes="ghost"
                            ToolTip.Tip="{x:Static res:Strings.PickFolderTitle}"
                            AutomationProperties.Name="{x:Static res:Strings.PickFolderTitle}"
                            Command="{Binding PickSourceFolderCommand}">
                      <PathIcon Data="{x:Static local:Icons.FolderOpen}" />
                    </Button>
                  </StackPanel>
                </TextBox.InnerRightContent>
              </TextBox>
            </StackPanel>

            <StackPanel Spacing="8">
              <TextBlock Classes="label" Text="{x:Static res:Strings.DestinationLabel}" />
              <TextBox Classes="field"
                       Text="{Binding DestinationPath}"
                       PlaceholderText="{x:Static res:Strings.DestinationHint}">
                <TextBox.InnerRightContent>
                  <StackPanel Classes="fieldActions">
                    <Button Classes="ghost"
                            ToolTip.Tip="{x:Static res:Strings.PickFolderTitle}"
                            AutomationProperties.Name="{x:Static res:Strings.PickFolderTitle}"
                            Command="{Binding PickDestinationFolderCommand}">
                      <PathIcon Data="{x:Static local:Icons.FolderOpen}" />
                    </Button>
                  </StackPanel>
                </TextBox.InnerRightContent>
              </TextBox>
            </StackPanel>
          </StackPanel>
        </Border>

        <Border Classes="card">
          <StackPanel Spacing="18">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Border Classes="stepBadge">
                <TextBlock Text="2" />
              </Border>
              <TextBlock Classes="cardTitle" Text="{x:Static res:Strings.SectionSecurity}" />
            </StackPanel>

            <StackPanel Spacing="8">
              <TextBlock Classes="label" Text="{x:Static res:Strings.PasswordLabel}" />
              <TextBox Classes="field"
                       Text="{Binding Password}"
                       PasswordChar="{Binding RevealPassword, Converter={x:Static conv:PasswordConverters.RevealToPasswordChar}}"
                       RevealPassword="{Binding RevealPassword}"
                       PlaceholderText="{x:Static res:Strings.PasswordHint}">
                <TextBox.InnerRightContent>
                  <StackPanel Classes="fieldActions">
                    <ToggleButton Classes="ghost"
                                  IsChecked="{Binding RevealPassword}"
                                  ToolTip.Tip="{x:Static res:Strings.RevealPasswordTooltip}"
                                  AutomationProperties.Name="{x:Static res:Strings.RevealPasswordTooltip}">
                      <PathIcon Data="{x:Static local:Icons.Eye}" />
                    </ToggleButton>
                    <Button Classes="ghost"
                            Command="{Binding GeneratePasswordCommand}"
                            ToolTip.Tip="{x:Static res:Strings.GenerateButton}"
                            AutomationProperties.Name="{x:Static res:Strings.GenerateButton}">
                      <PathIcon Data="{x:Static local:Icons.Sparkle}" />
                    </Button>
                    <Button Classes="ghost"
                            Command="{Binding CopyPasswordCommand}"
                            ToolTip.Tip="{x:Static res:Strings.CopyButton}"
                            AutomationProperties.Name="{x:Static res:Strings.CopyButton}">
                      <PathIcon Data="{x:Static local:Icons.Clipboard}" />
                    </Button>
                  </StackPanel>
                </TextBox.InnerRightContent>
              </TextBox>

              <StackPanel Classes="reveal"
                          Spacing="8"
                          Margin="0,4,0,0"
                          IsVisible="{Binding HasStrength}"
                          Classes.strength-danger="{Binding Strength, Converter={x:Static conv:PasswordConverters.StrengthIsBand}, ConverterParameter=danger}"
                          Classes.strength-warning="{Binding Strength, Converter={x:Static conv:PasswordConverters.StrengthIsBand}, ConverterParameter=warning}"
                          Classes.strength-good="{Binding Strength, Converter={x:Static conv:PasswordConverters.StrengthIsBand}, ConverterParameter=good}"
                          Classes.strength-strong="{Binding Strength, Converter={x:Static conv:PasswordConverters.StrengthIsBand}, ConverterParameter=strong}">
                <Grid ColumnDefinitions="*,*,*,*,*" ColumnSpacing="6">
                  <Border Grid.Column="0" Classes="meterSegment" Classes.lit="{Binding Strength, Converter={x:Static conv:PasswordConverters.StrengthReaches}, ConverterParameter=1}" />
                  <Border Grid.Column="1" Classes="meterSegment" Classes.lit="{Binding Strength, Converter={x:Static conv:PasswordConverters.StrengthReaches}, ConverterParameter=2}" />
                  <Border Grid.Column="2" Classes="meterSegment" Classes.lit="{Binding Strength, Converter={x:Static conv:PasswordConverters.StrengthReaches}, ConverterParameter=3}" />
                  <Border Grid.Column="3" Classes="meterSegment" Classes.lit="{Binding Strength, Converter={x:Static conv:PasswordConverters.StrengthReaches}, ConverterParameter=4}" />
                  <Border Grid.Column="4" Classes="meterSegment" Classes.lit="{Binding Strength, Converter={x:Static conv:PasswordConverters.StrengthReaches}, ConverterParameter=5}" />
                </Grid>
                <TextBlock Classes="caption" Text="{Binding StrengthDescription}" />
              </StackPanel>
            </StackPanel>

            <StackPanel Spacing="8">
              <TextBlock Classes="label" Text="{x:Static res:Strings.ConfirmPasswordLabel}" />
              <TextBox Classes="field"
                       Classes.mismatch="{Binding ShowPasswordMismatch}"
                       Text="{Binding ConfirmPassword}"
                       PasswordChar="{Binding RevealPassword, Converter={x:Static conv:PasswordConverters.RevealToPasswordChar}}"
                       RevealPassword="{Binding RevealPassword}"
                       PlaceholderText="{x:Static res:Strings.ConfirmPasswordHint}" />
              <TextBlock Classes="caption reveal"
                         Foreground="{StaticResource DangerBrush}"
                         IsVisible="{Binding ShowPasswordMismatch}"
                         Text="{x:Static res:Strings.PasswordMismatch}" />
            </StackPanel>
          </StackPanel>
        </Border>

        <views:OperationStatusView />
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="1" Classes="actionBar">
      <Grid MaxWidth="820" ColumnDefinitions="*,Auto" ColumnSpacing="16">
        <WrapPanel Grid.Column="0"
                   VerticalAlignment="Center"
                   ItemSpacing="8"
                   LineSpacing="8">
          <Border Classes="chip" ToolTip.Tip="{x:Static res:Strings.EncryptionLabel}">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <PathIcon Data="{x:Static local:Icons.Lock}" />
              <TextBlock Text="{Binding EncryptionName}" />
            </StackPanel>
          </Border>
          <Border Classes="chip" ToolTip.Tip="{x:Static res:Strings.KeyDerivationLabel}">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <PathIcon Data="{x:Static local:Icons.Key}" />
              <TextBlock Text="{Binding KeyDerivationName}" />
            </StackPanel>
          </Border>
          <Border Classes="chip" ToolTip.Tip="{x:Static res:Strings.CompressionLabel}">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <PathIcon Data="{x:Static local:Icons.Archive}" />
              <TextBlock Text="{Binding CompressionName}" />
            </StackPanel>
          </Border>
        </WrapPanel>

        <Button Grid.Column="1"
                Classes="primary"
                VerticalAlignment="Center"
                IsDefault="{Binding IsActivePage}"
                Command="{Binding StartCommand}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <PathIcon Data="{x:Static local:Icons.ShieldLock}" />
            <TextBlock Text="{x:Static res:Strings.StartBackup}" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </Grid>
    </Border>
  </Grid>
</UserControl>
