<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:BackupZCrypt.Desktop.ViewModels"
        xmlns:m="using:BackupZCrypt.Desktop.Models"
        xmlns:res="using:BackupZCrypt.Desktop.Resources"
        x:Class="BackupZCrypt.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="BackupZCrypt"
        Icon="avares://BackupZCrypt/Resources/BackupZCrypt.png"
        Width="1120" Height="760"
        MinWidth="960" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="-1"
        WindowDecorations="BorderOnly"
        Background="{StaticResource AppBackgroundBrush}">

  <Grid RowDefinitions="38,*">

    <Grid Grid.Row="0">
      <Grid ColumnDefinitions="248,*" IsHitTestVisible="False">
        <Border Grid.Column="0" Background="{StaticResource SidebarBackgroundBrush}" />
        <Border Grid.Column="1" Background="{StaticResource AppBackgroundBrush}" />
      </Grid>

      <Grid ColumnDefinitions="*,Auto">
        <Border Grid.Column="0"
                Background="Transparent"
                PointerPressed="OnTitleBarPressed"
                DoubleTapped="OnTitleBarDoubleTapped" />

        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button Classes="chrome" Click="OnMinimize" ToolTip.Tip="{x:Static res:Strings.WindowMinimize}">
            <Path Stroke="{StaticResource PrimaryTextBrush}" StrokeThickness="1" Data="M0,5 H10" />
          </Button>
          <Button Classes="chrome" Click="OnMaximizeRestore" ToolTip.Tip="{x:Static res:Strings.WindowMaximize}">
            <Panel Width="10" Height="10">
              <Path x:Name="MaximizeGlyph"
                    Stroke="{StaticResource PrimaryTextBrush}" StrokeThickness="1"
                    Data="M0,0 H10 V10 H0 Z" />
              <Path x:Name="RestoreGlyph"
                    IsVisible="False"
                    Stroke="{StaticResource PrimaryTextBrush}" StrokeThickness="1"
                    Data="M0,3 H7 V10 H0 Z M3,3 V0 H10 V7 H7" />
            </Panel>
          </Button>
          <Button Classes="chrome chromeClose" Click="OnClose" ToolTip.Tip="{x:Static res:Strings.WindowClose}">
            <Path Stroke="{StaticResource PrimaryTextBrush}" StrokeThickness="1" Data="M0,0 L10,10 M0,10 L10,0" />
          </Button>
        </StackPanel>
      </Grid>
    </Grid>

    <Grid Grid.Row="1" ColumnDefinitions="248,*">

    <Border Grid.Column="0"
            Background="{StaticResource SidebarBackgroundBrush}"
            BorderBrush="{StaticResource CardBorderBrush}"
            BorderThickness="0,0,1,0">
      <Grid RowDefinitions="Auto,*,Auto">

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="16,6,16,14" Spacing="12">
          <Image Source="avares://BackupZCrypt/Resources/BackupZCrypt.png"
                 Width="40" Height="40"
                 VerticalAlignment="Center" />
          <StackPanel Spacing="3" VerticalAlignment="Center">
            <TextBlock FontSize="21" FontWeight="Bold" LetterSpacing="-0.2">
              <Run Text="Backup" Foreground="{StaticResource PrimaryTextBrush}" /><Run Text="ZCrypt" Foreground="{StaticResource AccentBrush}" />
            </TextBlock>
            <TextBlock Classes="dim"
                       FontSize="12"
                       Text="{x:Static res:Strings.AppTagline}" />
          </StackPanel>
        </StackPanel>

        <ListBox Grid.Row="1"
                 Classes="nav"
                 ItemsSource="{Binding NavigationItems}"
                 SelectedItem="{Binding SelectedItem}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="m:NavigationItem">
              <StackPanel Orientation="Horizontal" Spacing="12">
                <PathIcon Data="{Binding Icon}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Title}"
                           FontSize="14"
                           VerticalAlignment="Center" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <Border Grid.Row="2"
                Margin="24,16,24,20"
                HorizontalAlignment="Left"
                Background="{StaticResource InfoCardBrush}"
                BorderBrush="{StaticResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="999"
                Padding="10,4">
          <TextBlock FontSize="11"
                     FontWeight="Medium"
                     Foreground="{StaticResource AccentBrush}"
                     Text="{Binding VersionText}" />
        </Border>
      </Grid>
    </Border>

    <TransitioningContentControl Grid.Column="1" Content="{Binding CurrentPage}">
      <TransitioningContentControl.PageTransition>
        <CrossFade Duration="0:0:0.20" FadeInEasing="CubicEaseOut" FadeOutEasing="CubicEaseIn" />
      </TransitioningContentControl.PageTransition>
    </TransitioningContentControl>
    </Grid>
  </Grid>
</Window>
