<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:BackupZCrypt.Desktop.ViewModels"
        xmlns:m="using:BackupZCrypt.Desktop.Models"
        xmlns:res="using:BackupZCrypt.Desktop.Resources"
        xmlns:anim="using:BackupZCrypt.Desktop.Animations"
        x:Class="BackupZCrypt.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="BackupZCrypt"
        Icon="avares://BackupZCrypt/Resources/BackupZCrypt.png"
        Width="1120" Height="760"
        MinWidth="960" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="-1"
        WindowDecorations="BorderOnly"
        Background="{StaticResource AppBackgroundBrush}">

  <Window.Resources>
    <DataTemplate x:Key="NavigationItemTemplate" x:DataType="m:NavigationItem">
      <StackPanel Orientation="Horizontal" Spacing="12">
        <PathIcon Data="{Binding Icon}" VerticalAlignment="Center" />
        <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
      </StackPanel>
    </DataTemplate>
  </Window.Resources>

  <Grid ColumnDefinitions="248,*">

    <Border Grid.Column="0"
            Background="{StaticResource SidebarBackgroundBrush}"
            BorderBrush="{StaticResource DividerBrush}"
            BorderThickness="0,0,1,0">
      <Grid RowDefinitions="Auto,Auto,*,Auto,Auto">

        <Grid Grid.Row="0"
              Background="Transparent"
              PointerPressed="OnTitleBarPressed"
              DoubleTapped="OnTitleBarDoubleTapped">
          <StackPanel Orientation="Horizontal" Spacing="12" Margin="20,26,16,28">
            <Image Source="{StaticResource AppLogoImage}"
                   Width="38" Height="38"
                   VerticalAlignment="Center" />
            <StackPanel Spacing="1" VerticalAlignment="Center">
              <TextBlock FontSize="18" FontWeight="Bold" LetterSpacing="-0.3">
                <Run Text="Backup" Foreground="{StaticResource PrimaryTextBrush}" /><Run Text="ZCrypt" Foreground="{StaticResource AccentBrush}" />
              </TextBlock>
              <TextBlock Classes="muted"
                         FontSize="12"
                         Text="{x:Static res:Strings.AppTagline}" />
            </StackPanel>
          </StackPanel>
        </Grid>

        <ListBox Grid.Row="1"
                 Classes="nav"
                 Margin="12,0"
                 ItemsSource="{Binding OperationItems}"
                 SelectedItem="{Binding SelectedOperation}"
                 ItemTemplate="{StaticResource NavigationItemTemplate}" />

        <ListBox Grid.Row="3"
                 Classes="nav"
                 Margin="12,0,12,8"
                 ItemsSource="{Binding UtilityItems}"
                 SelectedItem="{Binding SelectedUtility}"
                 ItemTemplate="{StaticResource NavigationItemTemplate}" />

        <Border Grid.Row="4"
                BorderBrush="{StaticResource DividerBrush}"
                BorderThickness="0,1,0,0"
                Margin="20,4,20,0"
                Padding="2,14,0,18">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Ellipse Width="6" Height="6"
                     Fill="{StaticResource AccentBrush}"
                     VerticalAlignment="Center" />
            <TextBlock Classes="muted numeric"
                       FontSize="12"
                       VerticalAlignment="Center"
                       Text="{Binding VersionText}" />
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <Grid Grid.Column="1" RowDefinitions="38,*">
      <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
        <Border Grid.Column="0"
                Background="Transparent"
                PointerPressed="OnTitleBarPressed"
                DoubleTapped="OnTitleBarDoubleTapped" />

        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button Classes="chrome"
                  Click="OnMinimize"
                  ToolTip.Tip="{x:Static res:Strings.WindowMinimize}"
                  AutomationProperties.Name="{x:Static res:Strings.WindowMinimize}">
            <Path Data="M0,5 H10" />
          </Button>
          <Button Classes="chrome"
                  Click="OnMaximizeRestore"
                  ToolTip.Tip="{x:Static res:Strings.WindowMaximize}"
                  AutomationProperties.Name="{x:Static res:Strings.WindowMaximize}">
            <Panel Width="10" Height="10">
              <Path x:Name="MaximizeGlyph" Data="M0.5,0.5 H9.5 V9.5 H0.5 Z" />
              <Path x:Name="RestoreGlyph"
                    IsVisible="False"
                    Data="M0.5,2.5 H7.5 V9.5 H0.5 Z M2.5,2.5 V0.5 H9.5 V7.5 H7.5" />
            </Panel>
          </Button>
          <Button Classes="chrome chromeClose"
                  Click="OnClose"
                  ToolTip.Tip="{x:Static res:Strings.WindowClose}"
                  AutomationProperties.Name="{x:Static res:Strings.WindowClose}">
            <Path Data="M0,0 L10,10 M0,10 L10,0" />
          </Button>
        </StackPanel>
      </Grid>

      <TransitioningContentControl Grid.Row="1"
                                   ClipToBounds="True"
                                   Content="{Binding CurrentPage}">
        <TransitioningContentControl.PageTransition>
          <anim:PageEntranceTransition />
        </TransitioningContentControl.PageTransition>
      </TransitioningContentControl>
    </Grid>
  </Grid>
</Window>
