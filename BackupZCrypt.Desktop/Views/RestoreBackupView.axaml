<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BackupZCrypt.Desktop.ViewModels"
             xmlns:views="using:BackupZCrypt.Desktop.Views"
             xmlns:res="using:BackupZCrypt.Desktop.Resources"
             xmlns:local="using:BackupZCrypt.Desktop"
             x:Class="BackupZCrypt.Desktop.Views.RestoreBackupView"
             x:DataType="vm:RestoreBackupViewModel">

  <ScrollViewer>
    <StackPanel Margin="40,32,40,40" Spacing="20" MaxWidth="860">

      <StackPanel Spacing="6" Margin="0,0,0,8">
        <TextBlock Classes="h1" Text="{x:Static res:Strings.RestoreTitle}" />
        <TextBlock Classes="subtitle" Text="{x:Static res:Strings.RestoreSubtitle}" />
      </StackPanel>

      <Border Classes="card">
        <StackPanel Spacing="16">
          <TextBlock Classes="section" Text="{x:Static res:Strings.SectionLocations}" />

          <StackPanel Spacing="6">
            <TextBlock Classes="label" Text="{x:Static res:Strings.BackupLabel}" />
            <Grid ColumnDefinitions="*,Auto">
              <TextBox Grid.Column="0"
                       Classes="field"
                       Text="{Binding SourcePath}"
                       PlaceholderText="{x:Static res:Strings.BackupHint}" />
              <Button Grid.Column="1"
                      Margin="8,0,0,0"
                      Classes="iconBtn"
                      ToolTip.Tip="{x:Static res:Strings.PickFolderTitle}"
                      AutomationProperties.Name="{x:Static res:Strings.PickFolderTitle}"
                      Command="{Binding PickBackupFolderCommand}">
                <PathIcon Data="{x:Static local:Icons.FolderOpen}" />
              </Button>
            </Grid>
          </StackPanel>

          <StackPanel Spacing="6">
            <TextBlock Classes="label" Text="{x:Static res:Strings.DestinationLabel}" />
            <Grid ColumnDefinitions="*,Auto">
              <TextBox Grid.Column="0"
                       Classes="field"
                       Text="{Binding DestinationPath}"
                       PlaceholderText="{x:Static res:Strings.RestoreDestinationHint}" />
              <Button Grid.Column="1"
                      Margin="8,0,0,0"
                      Classes="iconBtn"
                      ToolTip.Tip="{x:Static res:Strings.PickFolderTitle}"
                      AutomationProperties.Name="{x:Static res:Strings.PickFolderTitle}"
                      Command="{Binding PickDestinationFolderCommand}">
                <PathIcon Data="{x:Static local:Icons.FolderOpen}" />
              </Button>
            </Grid>
          </StackPanel>

          <Border Classes="warningBanner" IsVisible="{Binding HasDetection}">
            <Grid ColumnDefinitions="Auto,*">
              <PathIcon Grid.Column="0"
                        Data="{x:Static local:Icons.Warning}"
                        Width="16" Height="16"
                        Margin="0,1,10,0"
                        VerticalAlignment="Top"
                        Foreground="{StaticResource WarningBrush}" />
              <TextBlock Grid.Column="1"
                         Text="{Binding DetectionMessage}"
                         TextWrapping="Wrap"
                         FontSize="13"
                         Foreground="{StaticResource WarningBrush}" />
            </Grid>
          </Border>
        </StackPanel>
      </Border>

      <Border Classes="card" IsVisible="{Binding IsPasswordRequired}">
        <StackPanel Spacing="16">
          <TextBlock Classes="section" Text="{x:Static res:Strings.SectionSecurity}" />
          <StackPanel Spacing="6">
            <TextBlock Classes="label" Text="{x:Static res:Strings.PasswordLabel}" />
            <TextBox Classes="field"
                     Text="{Binding Password}"
                     PasswordChar="●"
                     PlaceholderText="{x:Static res:Strings.BackupPasswordHint}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <Button Classes="primary"
              HorizontalAlignment="Left"
              IsDefault="{Binding IsActivePage}"
              Content="{x:Static res:Strings.StartRestore}"
              Command="{Binding StartCommand}" />

      <views:OperationStatusView />
    </StackPanel>
  </ScrollViewer>
</UserControl>
