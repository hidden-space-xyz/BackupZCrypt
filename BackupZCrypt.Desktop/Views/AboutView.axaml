<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BackupZCrypt.Desktop.ViewModels"
             xmlns:m="using:BackupZCrypt.Desktop.Models"
             xmlns:res="using:BackupZCrypt.Desktop.Resources"
             xmlns:local="using:BackupZCrypt.Desktop"
             x:Class="BackupZCrypt.Desktop.Views.AboutView"
             x:DataType="vm:AboutViewModel">

  <UserControl.Resources>
    <DataTemplate x:Key="AlgorithmTemplate" x:DataType="m:AlgorithmInfo">
      <StackPanel Spacing="3" Margin="0,4,0,8">
        <TextBlock Text="{Binding Name}"
                   FontWeight="SemiBold"
                   Foreground="{StaticResource PrimaryTextBrush}" />
        <TextBlock Text="{Binding Summary}"
                   FontSize="12"
                   FontWeight="Medium"
                   TextWrapping="Wrap"
                   Foreground="{StaticResource AccentBrush}" />
        <TextBlock Text="{Binding Description}"
                   Classes="dim"
                   FontSize="13"
                   TextWrapping="Wrap" />
      </StackPanel>
    </DataTemplate>
  </UserControl.Resources>

  <ScrollViewer>
    <StackPanel Margin="40,32,40,40" Spacing="20" MaxWidth="860">

      <StackPanel Spacing="6" Margin="0,0,0,8">
        <TextBlock Classes="h1" Text="{x:Static res:Strings.AboutTitle}" />
        <TextBlock Classes="subtitle" Text="{x:Static res:Strings.AboutSubtitle}" />
      </StackPanel>

      <Border Classes="card">
        <StackPanel Spacing="18">
          <TextBlock Classes="section" Text="{x:Static res:Strings.HelpGuideSection}" />

          <StackPanel Spacing="16">
            <Grid ColumnDefinitions="Auto,*">
              <Border Grid.Column="0" Classes="helpBadge">
                <PathIcon Data="{x:Static local:Icons.ShieldLock}" />
              </Border>
              <StackPanel Grid.Column="1" Margin="14,0,0,0" Spacing="3" VerticalAlignment="Center">
                <TextBlock Classes="label" Text="{x:Static res:Strings.HelpCreateTitle}" />
                <TextBlock Classes="dim" FontSize="13" TextWrapping="Wrap" Text="{x:Static res:Strings.HelpCreateText}" />
              </StackPanel>
            </Grid>

            <Grid ColumnDefinitions="Auto,*">
              <Border Grid.Column="0" Classes="helpBadge">
                <PathIcon Data="{x:Static local:Icons.ArrowSync}" />
              </Border>
              <StackPanel Grid.Column="1" Margin="14,0,0,0" Spacing="3" VerticalAlignment="Center">
                <TextBlock Classes="label" Text="{x:Static res:Strings.HelpUpdateTitle}" />
                <TextBlock Classes="dim" FontSize="13" TextWrapping="Wrap" Text="{x:Static res:Strings.HelpUpdateText}" />
              </StackPanel>
            </Grid>

            <Grid ColumnDefinitions="Auto,*">
              <Border Grid.Column="0" Classes="helpBadge">
                <PathIcon Data="{x:Static local:Icons.BoxArrowDown}" />
              </Border>
              <StackPanel Grid.Column="1" Margin="14,0,0,0" Spacing="3" VerticalAlignment="Center">
                <TextBlock Classes="label" Text="{x:Static res:Strings.HelpRestoreTitle}" />
                <TextBlock Classes="dim" FontSize="13" TextWrapping="Wrap" Text="{x:Static res:Strings.HelpRestoreText}" />
              </StackPanel>
            </Grid>

            <Grid ColumnDefinitions="Auto,*">
              <Border Grid.Column="0" Classes="helpBadge">
                <PathIcon Data="{x:Static local:Icons.ShieldCheck}" />
              </Border>
              <StackPanel Grid.Column="1" Margin="14,0,0,0" Spacing="3" VerticalAlignment="Center">
                <TextBlock Classes="label" Text="{x:Static res:Strings.HelpVerifyTitle}" />
                <TextBlock Classes="dim" FontSize="13" TextWrapping="Wrap" Text="{x:Static res:Strings.HelpVerifyText}" />
              </StackPanel>
            </Grid>

            <Grid ColumnDefinitions="Auto,*">
              <Border Grid.Column="0" Classes="helpBadge">
                <PathIcon Data="{x:Static local:Icons.Settings}" />
              </Border>
              <StackPanel Grid.Column="1" Margin="14,0,0,0" Spacing="3" VerticalAlignment="Center">
                <TextBlock Classes="label" Text="{x:Static res:Strings.HelpSettingsTitle}" />
                <TextBlock Classes="dim" FontSize="13" TextWrapping="Wrap" Text="{x:Static res:Strings.HelpSettingsText}" />
              </StackPanel>
            </Grid>
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="8">
          <TextBlock Classes="section" Text="{x:Static res:Strings.HelpPasswordTitle}" />
          <TextBlock Classes="dim" FontSize="13" TextWrapping="Wrap" Text="{x:Static res:Strings.HelpPasswordText}" />
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="6">
          <TextBlock Classes="section" Text="{x:Static res:Strings.EncryptionLabel}" />
          <ItemsControl ItemsSource="{Binding EncryptionAlgorithms}"
                        ItemTemplate="{StaticResource AlgorithmTemplate}" />
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="6">
          <TextBlock Classes="section" Text="{x:Static res:Strings.KeyDerivationLabel}" />
          <ItemsControl ItemsSource="{Binding KeyDerivationAlgorithms}"
                        ItemTemplate="{StaticResource AlgorithmTemplate}" />
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="6">
          <TextBlock Classes="section" Text="{x:Static res:Strings.CompressionLabel}" />
          <ItemsControl ItemsSource="{Binding CompressionAlgorithms}"
                        ItemTemplate="{StaticResource AlgorithmTemplate}" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
