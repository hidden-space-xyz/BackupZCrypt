<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BackupZCrypt.Desktop.ViewModels"
             xmlns:m="using:BackupZCrypt.Desktop.Models"
             xmlns:res="using:BackupZCrypt.Desktop.Resources"
             x:Class="BackupZCrypt.Desktop.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

  <ScrollViewer>
    <StackPanel Margin="40,32,40,40" Spacing="20" MaxWidth="860">

      <StackPanel Spacing="6" Margin="0,0,0,8">
        <TextBlock Classes="h1" Text="{x:Static res:Strings.SettingsTitle}" />
        <TextBlock Classes="subtitle" Text="{x:Static res:Strings.SettingsSubtitle}" />
      </StackPanel>

      <Border Classes="card">
        <StackPanel Spacing="16">
          <TextBlock Classes="section" Text="{x:Static res:Strings.SectionDefaults}" />

          <StackPanel Spacing="6">
            <TextBlock Classes="label" Text="{x:Static res:Strings.EncryptionLabel}" />
            <ComboBox Classes="field"
                      ItemsSource="{Binding EncryptionOptions}"
                      SelectedItem="{Binding SelectedEncryption}">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="m:EncryptionOption">
                  <StackPanel Spacing="2">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Description}"
                               Classes="dim"
                               FontSize="12"
                               TextWrapping="Wrap" />
                  </StackPanel>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>

          <StackPanel Spacing="6">
            <TextBlock Classes="label" Text="{x:Static res:Strings.KeyDerivationLabel}" />
            <ComboBox Classes="field"
                      ItemsSource="{Binding KeyDerivationOptions}"
                      SelectedItem="{Binding SelectedKeyDerivation}">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="m:KeyDerivationOption">
                  <StackPanel Spacing="2">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Description}"
                               Classes="dim"
                               FontSize="12"
                               TextWrapping="Wrap" />
                  </StackPanel>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>

          <StackPanel Spacing="6">
            <TextBlock Classes="label" Text="{x:Static res:Strings.CompressionLabel}" />
            <ComboBox Classes="field"
                      ItemsSource="{Binding CompressionOptions}"
                      SelectedItem="{Binding SelectedCompression}">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="m:CompressionOption">
                  <StackPanel Spacing="2">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Description}"
                               Classes="dim"
                               FontSize="12"
                               TextWrapping="Wrap" />
                  </StackPanel>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="16">
          <TextBlock Classes="section" Text="{x:Static res:Strings.BenchmarkSection}" />
          <TextBlock Classes="dim"
                     FontSize="12"
                     TextWrapping="Wrap"
                     Text="{x:Static res:Strings.BenchmarkDescription}" />

          <StackPanel Spacing="6">
            <TextBlock Classes="label" Text="{x:Static res:Strings.BenchmarkDataAmountLabel}" />
            <Grid ColumnDefinitions="*,12,Auto">
              <TextBox Grid.Column="0"
                       Classes="field"
                       Text="{Binding BenchmarkDataAmount}"
                       PlaceholderText="{x:Static res:Strings.BenchmarkDataAmountHint}" />
              <ComboBox Grid.Column="2"
                        MinWidth="90"
                        VerticalAlignment="Stretch"
                        ItemsSource="{Binding DataUnitOptions}"
                        SelectedItem="{Binding SelectedDataUnit}">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="m:DataSizeUnitOption">
                    <TextBlock Text="{Binding Name}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </Grid>
          </StackPanel>

          <StackPanel Orientation="Horizontal" Spacing="12">
            <Button Classes="primary"
                    Content="{x:Static res:Strings.BenchmarkRunButton}"
                    Command="{Binding RunBenchmarkCommand}" />
            <TextBlock Classes="dim"
                       VerticalAlignment="Center"
                       IsVisible="{Binding IsBenchmarkRunning}"
                       Text="{x:Static res:Strings.BenchmarkRunningText}" />
          </StackPanel>

          <StackPanel Spacing="4" IsVisible="{Binding ShowBenchmarkResult}">
            <TextBlock FontWeight="SemiBold"
                       Foreground="{StaticResource SuccessBrush}"
                       Text="{Binding BenchmarkDurationText}" />
            <TextBlock Classes="dim"
                       FontSize="12"
                       Text="{Binding BenchmarkThroughputText}" />
            <TextBlock Classes="dim"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Text="{x:Static res:Strings.BenchmarkDisclaimer}" />
          </StackPanel>

          <TextBlock FontSize="12"
                     TextWrapping="Wrap"
                     IsVisible="{Binding HasBenchmarkError}"
                     Foreground="{StaticResource DangerBrush}"
                     Text="{Binding BenchmarkError}" />
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="16">
          <TextBlock Classes="section" Text="{x:Static res:Strings.LanguageLabel}" />
          <ComboBox Classes="field"
                    ItemsSource="{Binding LanguageOptions}"
                    SelectedItem="{Binding SelectedLanguage}">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="m:LanguageOption">
                <TextBlock Text="{Binding Name}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <TextBlock Classes="dim"
                     FontSize="12"
                     TextWrapping="Wrap"
                     IsVisible="{Binding ShowRestartNote}"
                     Foreground="{StaticResource WarningBrush}"
                     Text="{x:Static res:Strings.LanguageRestartNote}" />
        </StackPanel>
      </Border>

      <StackPanel Orientation="Horizontal" Spacing="12">
        <Button Classes="primary"
                Content="{x:Static res:Strings.SaveButton}"
                Command="{Binding SaveCommand}" />
        <TextBlock Classes="dim"
                   VerticalAlignment="Center"
                   IsVisible="{Binding ShowSavedNotice}"
                   Foreground="{StaticResource SuccessBrush}"
                   Text="{x:Static res:Strings.SettingsSavedNotice}" />
      </StackPanel>

      <StackPanel Spacing="4">
        <TextBlock Classes="section" Text="{x:Static res:Strings.SettingsFileLabel}" />
        <SelectableTextBlock Classes="mono"
                             TextWrapping="Wrap"
                             Foreground="{StaticResource DimTextBrush}"
                             SelectionBrush="{StaticResource AccentBrush}"
                             Text="{Binding SettingsFilePath}" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
