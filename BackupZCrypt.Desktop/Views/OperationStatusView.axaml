<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BackupZCrypt.Desktop.ViewModels"
             xmlns:res="using:BackupZCrypt.Desktop.Resources"
             x:Class="BackupZCrypt.Desktop.Views.OperationStatusView"
             x:DataType="vm:OperationViewModelBase">

  <StackPanel Spacing="20">

    <Border Classes="card" IsVisible="{Binding IsRunning}">
      <StackPanel Spacing="14">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
            <TextBlock Classes="label" Text="{Binding ProgressText}" />
            <TextBlock Classes="dim" FontSize="12" Text="{Binding ElapsedText}" />
          </StackPanel>
          <Button Grid.Column="1"
                  Content="{x:Static res:Strings.CancelButton}"
                  Command="{Binding CancelOperationCommand}"
                  VerticalAlignment="Center" />
        </Grid>
        <ProgressBar Height="8"
                     CornerRadius="4"
                     Minimum="0"
                     Maximum="100"
                     Value="{Binding ProgressValue}"
                     Foreground="{StaticResource AccentBrush}" />
      </StackPanel>
    </Border>

    <Border Classes="card"
            Background="{StaticResource WarningCardBrush}"
            IsVisible="{Binding ShowWarnings}">
      <StackPanel Spacing="12">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <TextBlock Text="⚠" FontSize="16" Foreground="{StaticResource WarningBrush}" />
          <TextBlock Classes="label"
                     Text="{x:Static res:Strings.WarningsTitle}"
                     Foreground="{StaticResource WarningBrush}" />
        </StackPanel>
        <ItemsControl ItemsSource="{Binding Warnings}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="x:String">
              <TextBlock Text="{Binding}"
                         TextWrapping="Wrap"
                         Margin="0,2"
                         Foreground="{StaticResource PrimaryTextBrush}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <StackPanel Orientation="Horizontal" Spacing="10">
          <Button Classes="primary"
                  Content="{x:Static res:Strings.ContinueAnyway}"
                  Command="{Binding ContinueAnywayCommand}" />
          <Button Content="{x:Static res:Strings.DismissButton}"
                  Command="{Binding DismissWarningsCommand}" />
        </StackPanel>
      </StackPanel>
    </Border>

    <Border Classes="card" IsVisible="{Binding HasResult}">
      <StackPanel Spacing="12">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <TextBlock Text="✔"
                     FontSize="16"
                     Foreground="{StaticResource SuccessBrush}"
                     IsVisible="{Binding ResultIsSuccess}" />
          <TextBlock Text="✘"
                     FontSize="16"
                     Foreground="{StaticResource DangerBrush}"
                     IsVisible="{Binding !ResultIsSuccess}" />
          <TextBlock Classes="label" FontSize="15" Text="{Binding ResultTitle}" />
        </StackPanel>

        <StackPanel Spacing="4" IsVisible="{Binding HasResultDetails}">
          <TextBlock Classes="dim" Text="{Binding ResultFiles}" />
          <TextBlock Classes="dim" Text="{Binding ResultDuration}" />
          <TextBlock Classes="dim" Text="{Binding ResultSize}" />
        </StackPanel>

        <StackPanel Spacing="6" IsVisible="{Binding ShowErrors}">
          <TextBlock Classes="label"
                     Text="{x:Static res:Strings.ErrorsTitle}"
                     Foreground="{StaticResource DangerBrush}" />
          <ItemsControl ItemsSource="{Binding Errors}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="x:String">
                <TextBlock Text="{Binding}"
                           TextWrapping="Wrap"
                           Margin="0,2"
                           Foreground="{StaticResource DangerBrush}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
