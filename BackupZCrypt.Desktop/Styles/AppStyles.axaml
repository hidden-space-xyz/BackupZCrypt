<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Style Selector="TextBlock.h1">
    <Setter Property="FontSize" Value="24" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="-0.4" />
    <Setter Property="LineHeight" Value="30" />
    <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
  </Style>

  <Style Selector="TextBlock.subtitle">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="LineHeight" Value="21" />
    <Setter Property="Foreground" Value="{StaticResource DimTextBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style Selector="TextBlock.cardTitle">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="TextBlock.label">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
  </Style>

  <Style Selector="TextBlock.caption">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="LineHeight" Value="18" />
    <Setter Property="Foreground" Value="{StaticResource DimTextBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style Selector="TextBlock.body">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="LineHeight" Value="20" />
    <Setter Property="Foreground" Value="{StaticResource DimTextBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
  </Style>

  <Style Selector="TextBlock.numeric">
    <Setter Property="FontFeatures" Value="+tnum" />
  </Style>

  <Style Selector="TextBlock.mono, SelectableTextBlock.mono">
    <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <Style Selector=":is(Control).reveal">
    <Setter Property="Opacity" Value="0" />
    <Setter Property="RenderTransform" Value="translateY(6px)" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.22" Easing="0.2,0,0,1" />
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.32" Easing="0.16,1,0.3,1" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector=":is(Control).reveal[IsVisible=True]">
    <Setter Property="Opacity" Value="1" />
    <Setter Property="RenderTransform" Value="translateY(0px)" />
  </Style>

  <Style Selector="Border.card">
    <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource CardOutlineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Padding" Value="24,22,24,24" />
    <Setter Property="BoxShadow" Value="{StaticResource CardShadow}" />
  </Style>

  <Style Selector="Border.stepBadge">
    <Setter Property="Width" Value="24" />
    <Setter Property="Height" Value="24" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Background" Value="{StaticResource AccentTintStrongBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Border.stepBadge TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Border.stepBadge PathIcon">
    <Setter Property="Width" Value="13" />
    <Setter Property="Height" Value="13" />
    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
  </Style>

  <Style Selector="Border.pageIcon">
    <Setter Property="Width" Value="48" />
    <Setter Property="Height" Value="48" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Background" Value="{StaticResource IconTileBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource AccentTintStrongBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="VerticalAlignment" Value="Top" />
  </Style>

  <Style Selector="Border.pageIcon PathIcon">
    <Setter Property="Width" Value="22" />
    <Setter Property="Height" Value="22" />
    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
  </Style>

  <Style Selector="Border.helpBadge">
    <Setter Property="Width" Value="36" />
    <Setter Property="Height" Value="36" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Background" Value="{StaticResource AccentTintBrush}" />
    <Setter Property="VerticalAlignment" Value="Top" />
  </Style>

  <Style Selector="Border.helpBadge PathIcon">
    <Setter Property="Width" Value="18" />
    <Setter Property="Height" Value="18" />
    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
  </Style>

  <Style Selector="Border.notice">
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="12,10" />
  </Style>

  <Style Selector="Border.notice PathIcon">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="Margin" Value="0,1,10,0" />
    <Setter Property="VerticalAlignment" Value="Top" />
  </Style>

  <Style Selector="Border.notice TextBlock">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="LineHeight" Value="19" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style Selector="Border.notice.warning">
    <Setter Property="Background" Value="{StaticResource WarningTintBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource WarningOutlineBrush}" />
  </Style>

  <Style Selector="Border.notice.warning PathIcon">
    <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
  </Style>

  <Style Selector="Border.notice.warning TextBlock">
    <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
  </Style>

  <Style Selector="Border.notice.success">
    <Setter Property="Background" Value="{StaticResource SuccessTintBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource SuccessOutlineBrush}" />
  </Style>

  <Style Selector="Border.notice.success PathIcon">
    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
  </Style>

  <Style Selector="Border.notice.success TextBlock">
    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
  </Style>

  <Style Selector="Border.notice.danger">
    <Setter Property="Background" Value="{StaticResource DangerTintBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource DangerOutlineBrush}" />
  </Style>

  <Style Selector="Border.notice.danger PathIcon">
    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
  </Style>

  <Style Selector="Border.notice.danger TextBlock">
    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
  </Style>

  <Style Selector="Border.chip">
    <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource StrongBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="10,5,12,5" />
  </Style>

  <Style Selector="Border.chip PathIcon">
    <Setter Property="Width" Value="13" />
    <Setter Property="Height" Value="13" />
    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Border.chip TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{StaticResource DimTextBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Border.actionBar">
    <Setter Property="Background" Value="{StaticResource AppBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="Padding" Value="40,14" />
  </Style>

  <Style Selector="Button, ToggleButton">
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="FocusAdorner">
      <FocusAdornerTemplate>
        <Border BorderBrush="{StaticResource AccentBrush}"
                BorderThickness="2"
                CornerRadius="12"
                Margin="-3" />
      </FocusAdornerTemplate>
    </Setter>
  </Style>

  <Style Selector="Button /template/ ContentPresenter#PART_ContentPresenter,
                   ToggleButton /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.15" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
        <BrushTransition Property="Foreground" Duration="0:0:0.15" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{StaticResource PrimaryButtonBrush}" />
    <Setter Property="Foreground" Value="{StaticResource AccentForegroundBrush}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="Padding" Value="20,0" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="RenderTransform" Value="scale(1)" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" Easing="0.25,0.1,0.25,1" />
      </Transitions>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate TargetType="Button">
        <Border x:Name="ShadowHost"
                CornerRadius="{TemplateBinding CornerRadius}"
                BoxShadow="{StaticResource ButtonShadow}">
          <Border.Transitions>
            <Transitions>
              <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.18" />
            </Transitions>
          </Border.Transitions>
          <Panel>
            <Border x:Name="Fill"
                    Background="{TemplateBinding Background}"
                    CornerRadius="{TemplateBinding CornerRadius}" />
            <Border x:Name="DisabledFill"
                    Background="{StaticResource DisabledButtonBrush}"
                    Opacity="0"
                    CornerRadius="{TemplateBinding CornerRadius}">
              <Border.Transitions>
                <Transitions>
                  <DoubleTransition Property="Opacity" Duration="0:0:0.2" />
                </Transitions>
              </Border.Transitions>
            </Border>
            <Border x:Name="Tint"
                    Background="#FFFFFF"
                    Opacity="0"
                    CornerRadius="{TemplateBinding CornerRadius}">
              <Border.Transitions>
                <Transitions>
                  <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
                  <BrushTransition Property="Background" Duration="0:0:0.15" />
                </Transitions>
              </Border.Transitions>
            </Border>
            <Border x:Name="Edge"
                    BorderBrush="#40FFFFFF"
                    BorderThickness="0,1,0,0"
                    CornerRadius="{TemplateBinding CornerRadius}" />
            <ContentPresenter x:Name="PART_ContentPresenter"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Foreground="{TemplateBinding Foreground}"
                              Padding="{TemplateBinding Padding}"
                              RecognizesAccessKey="True"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
          </Panel>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="Button.primary /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource TransparentBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource TransparentBrush}" />
    <Setter Property="Foreground" Value="{StaticResource AccentForegroundBrush}" />
  </Style>

  <Style Selector="Button.primary:pointerover /template/ Border#Tint">
    <Setter Property="Opacity" Value="0.1" />
  </Style>

  <Style Selector="Button.primary:pointerover /template/ Border#ShadowHost">
    <Setter Property="BoxShadow" Value="{StaticResource ButtonHoverShadow}" />
  </Style>

  <Style Selector="Button.primary:pressed">
    <Setter Property="RenderTransform" Value="scale(0.97)" />
  </Style>

  <Style Selector="Button.primary:pressed /template/ Border#Tint">
    <Setter Property="Background" Value="#000000" />
    <Setter Property="Opacity" Value="0.08" />
  </Style>

  <Style Selector="Button.primary:pressed /template/ Border#ShadowHost">
    <Setter Property="BoxShadow" Value="{StaticResource ButtonPressedShadow}" />
  </Style>

  <Style Selector="Button.primary:disabled /template/ Border#DisabledFill">
    <Setter Property="Opacity" Value="1" />
  </Style>

  <Style Selector="Button.primary:disabled /template/ Border#Edge">
    <Setter Property="BorderBrush" Value="#0AFFFFFF" />
  </Style>

  <Style Selector="Button.primary:disabled /template/ Border#ShadowHost">
    <Setter Property="BoxShadow" Value="{StaticResource NoButtonShadow}" />
  </Style>

  <Style Selector="Button.primary:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
  </Style>

  <Style Selector="Button.primary PathIcon, Button.secondary PathIcon">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Button.secondary">
    <Setter Property="Background" Value="{StaticResource TransparentBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource StrongBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="Padding" Value="18,0" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="Button.secondary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource GhostHoverBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource HoverBorderBrush}" />
    <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
  </Style>

  <Style Selector="Button.secondary:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource GhostPressedBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource HoverBorderBrush}" />
  </Style>

  <Style Selector="Button.secondary:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource TransparentBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}" />
    <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
  </Style>

  <Style Selector="Button.ghost, ToggleButton.ghost">
    <Setter Property="Width" Value="30" />
    <Setter Property="Height" Value="30" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Background" Value="{StaticResource TransparentBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                   ToggleButton.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource GhostHoverBrush}" />
  </Style>

  <Style Selector="Button.ghost:pressed /template/ ContentPresenter#PART_ContentPresenter,
                   ToggleButton.ghost:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource GhostPressedBrush}" />
  </Style>

  <Style Selector="Button.ghost:disabled /template/ ContentPresenter#PART_ContentPresenter,
                   ToggleButton.ghost:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource TransparentBrush}" />
  </Style>

  <Style Selector="ToggleButton.ghost:checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource AccentTintBrush}" />
  </Style>

  <Style Selector="ToggleButton.ghost:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                   ToggleButton.ghost:checked:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource AccentTintStrongBrush}" />
  </Style>

  <Style Selector="ToggleButton.ghost:checked:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource TransparentBrush}" />
  </Style>

  <Style Selector="Button.ghost PathIcon, ToggleButton.ghost PathIcon">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="Foreground" Value="{StaticResource DimTextBrush}" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Foreground" Duration="0:0:0.15" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="Button.ghost:pointerover PathIcon, ToggleButton.ghost:pointerover PathIcon">
    <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
  </Style>

  <Style Selector="ToggleButton.ghost:checked PathIcon">
    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
  </Style>

  <Style Selector="Button.ghost:disabled PathIcon, ToggleButton.ghost:disabled PathIcon">
    <Setter Property="Opacity" Value="0.35" />
  </Style>

  <Style Selector="Button.chrome">
    <Setter Property="Background" Value="{StaticResource TransparentBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Width" Value="46" />
    <Setter Property="Height" Value="38" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
  </Style>

  <Style Selector="Button.chrome Path">
    <Setter Property="Stroke" Value="{StaticResource DimTextBrush}" />
    <Setter Property="StrokeThickness" Value="1" />
  </Style>

  <Style Selector="Button.chrome:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource NavHoverBrush}" />
  </Style>

  <Style Selector="Button.chrome:pointerover Path">
    <Setter Property="Stroke" Value="{StaticResource PrimaryTextBrush}" />
  </Style>

  <Style Selector="Button.chrome:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource NavPressedBrush}" />
  </Style>

  <Style Selector="Button.chrome:pressed">
    <Setter Property="RenderTransform" Value="none" />
  </Style>

  <Style Selector="Button.chromeClose:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#E5484D" />
  </Style>

  <Style Selector="Button.chromeClose:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#C93C41" />
  </Style>

  <Style Selector="Button.chromeClose:pointerover Path">
    <Setter Property="Stroke" Value="#FFFFFF" />
  </Style>

  <Style Selector="ListBox.nav">
    <Setter Property="Background" Value="{StaticResource TransparentBrush}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
  </Style>

  <Style Selector="ListBox.nav > ListBoxItem">
    <Setter Property="Padding" Value="12,10" />
    <Setter Property="Margin" Value="0,1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Background" Value="{StaticResource TransparentBrush}" />
    <Setter Property="FocusAdorner">
      <FocusAdornerTemplate>
        <Border BorderBrush="{StaticResource AccentBrush}"
                BorderThickness="2"
                CornerRadius="12"
                Margin="-2" />
      </FocusAdornerTemplate>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate TargetType="ListBoxItem">
        <Panel>
          <Border x:Name="Pill"
                  Background="{TemplateBinding Background}"
                  CornerRadius="{TemplateBinding CornerRadius}">
            <Border.Transitions>
              <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.18" />
              </Transitions>
            </Border.Transitions>
          </Border>
          <Border x:Name="Indicator"
                  Width="3"
                  Height="18"
                  CornerRadius="1.5"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Center"
                  Background="{StaticResource AccentBrush}"
                  Opacity="0"
                  RenderTransform="scaleY(0.3)">
            <Border.Transitions>
              <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.18" />
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.34" Easing="0.16,1,0.3,1" />
              </Transitions>
            </Border.Transitions>
          </Border>
          <ContentPresenter x:Name="PART_ContentPresenter"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Padding="{TemplateBinding Padding}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
        </Panel>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="ListBox.nav > ListBoxItem /template/ ContentPresenter#PART_ContentPresenter,
                   ListBox.segmented > ListBoxItem /template/ ContentPresenter#PART_ContentPresenter,
                   ListBox.tiles > ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource TransparentBrush}" />
  </Style>

  <Style Selector="ListBox.nav > ListBoxItem:pointerover /template/ Border#Pill">
    <Setter Property="Background" Value="{StaticResource NavHoverBrush}" />
  </Style>

  <Style Selector="ListBox.nav > ListBoxItem:pressed /template/ Border#Pill">
    <Setter Property="Background" Value="{StaticResource NavPressedBrush}" />
  </Style>

  <Style Selector="ListBox.nav > ListBoxItem:selected /template/ Border#Pill">
    <Setter Property="Background" Value="{StaticResource NavSelectedBrush}" />
  </Style>

  <Style Selector="ListBox.nav > ListBoxItem:selected /template/ Border#Indicator">
    <Setter Property="Opacity" Value="1" />
    <Setter Property="RenderTransform" Value="scaleY(1)" />
  </Style>

  <Style Selector="ListBox.nav > ListBoxItem PathIcon">
    <Setter Property="Width" Value="18" />
    <Setter Property="Height" Value="18" />
    <Setter Property="Foreground" Value="{StaticResource DimTextBrush}" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Foreground" Duration="0:0:0.18" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="ListBox.nav > ListBoxItem TextBlock">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{StaticResource DimTextBrush}" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Foreground" Duration="0:0:0.18" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="ListBox.nav > ListBoxItem:pointerover PathIcon">
    <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
  </Style>

  <Style Selector="ListBox.nav > ListBoxItem:pointerover TextBlock,
                   ListBox.nav > ListBoxItem:selected TextBlock">
    <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
  </Style>

  <Style Selector="ListBox.nav > ListBoxItem:selected PathIcon">
    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
  </Style>

  <Style Selector="ListBox.segmented">
    <Setter Property="Background" Value="{StaticResource FieldBackgroundBrush}" />
    <Setter Property="AutoScrollToSelectedItem" Value="False" />
    <Setter Property="BorderBrush" Value="{StaticResource StrongBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="3" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
    <Setter Property="ItemsPanel">
      <ItemsPanelTemplate>
        <StackPanel Orientation="Horizontal" Spacing="2" />
      </ItemsPanelTemplate>
    </Setter>
  </Style>

  <Style Selector="ListBox.segmented > ListBoxItem">
    <Setter Property="Padding" Value="14,0" />
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="Background" Value="{StaticResource TransparentBrush}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="FocusAdorner">
      <FocusAdornerTemplate>
        <Border BorderBrush="{StaticResource AccentBrush}"
                BorderThickness="2"
                CornerRadius="9"
                Margin="-2" />
      </FocusAdornerTemplate>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate TargetType="ListBoxItem">
        <Border x:Name="Pill"
                Background="{TemplateBinding Background}"
                CornerRadius="{TemplateBinding CornerRadius}"
                BoxShadow="{StaticResource NoButtonShadow}">
          <Border.Transitions>
            <Transitions>
              <BrushTransition Property="Background" Duration="0:0:0.18" />
              <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.18" />
            </Transitions>
          </Border.Transitions>
          <ContentPresenter x:Name="PART_ContentPresenter"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Padding="{TemplateBinding Padding}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="ListBox.segmented > ListBoxItem TextBlock">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{StaticResource DimTextBrush}" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Foreground" Duration="0:0:0.18" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="ListBox.segmented > ListBoxItem:pointerover TextBlock">
    <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
  </Style>

  <Style Selector="ListBox.segmented > ListBoxItem:selected /template/ Border#Pill">
    <Setter Property="Background" Value="#262E40" />
    <Setter Property="BoxShadow" Value="{StaticResource ButtonShadow}" />
  </Style>

  <Style Selector="ListBox.segmented > ListBoxItem:selected TextBlock">
    <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
  </Style>

  <Style Selector="ListBox.tiles">
    <Setter Property="Background" Value="{StaticResource TransparentBrush}" />
    <Setter Property="AutoScrollToSelectedItem" Value="False" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
  </Style>

  <Style Selector="ListBox.tiles > ListBoxItem">
    <Setter Property="Padding" Value="14,12" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Background" Value="{StaticResource FieldBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource StrongBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="VerticalContentAlignment" Value="Top" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="FocusAdorner">
      <FocusAdornerTemplate>
        <Border BorderBrush="{StaticResource AccentBrush}"
                BorderThickness="2"
                CornerRadius="14"
                Margin="-3" />
      </FocusAdornerTemplate>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate TargetType="ListBoxItem">
        <Border x:Name="Tile"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}">
          <Border.Transitions>
            <Transitions>
              <BrushTransition Property="Background" Duration="0:0:0.18" />
              <BrushTransition Property="BorderBrush" Duration="0:0:0.18" />
            </Transitions>
          </Border.Transitions>
          <Grid ColumnDefinitions="*,Auto">
            <ContentPresenter x:Name="PART_ContentPresenter"
                              Grid.Column="0"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Padding="{TemplateBinding Padding}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
            <Border x:Name="Check"
                    Grid.Column="1"
                    Width="18"
                    Height="18"
                    CornerRadius="9"
                    Margin="0,12,12,0"
                    VerticalAlignment="Top"
                    Background="{StaticResource AccentBrush}"
                    Opacity="0"
                    RenderTransform="scale(0.6)">
              <Border.Transitions>
                <Transitions>
                  <DoubleTransition Property="Opacity" Duration="0:0:0.16" />
                  <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.28" Easing="0.16,1,0.3,1" />
                </Transitions>
              </Border.Transitions>
              <Path Data="M4.6,9.2 L7.6,12.2 L13.4,6.2"
                    Stroke="{StaticResource AccentForegroundBrush}"
                    StrokeThickness="2"
                    StrokeLineCap="Round"
                    StrokeJoin="Round" />
            </Border>
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="ListBox.tiles > ListBoxItem:pointerover /template/ Border#Tile">
    <Setter Property="Background" Value="#131925" />
    <Setter Property="BorderBrush" Value="{StaticResource HoverBorderBrush}" />
  </Style>

  <Style Selector="ListBox.tiles > ListBoxItem:selected /template/ Border#Tile">
    <Setter Property="Background" Value="{StaticResource AccentTintBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
  </Style>

  <Style Selector="ListBox.tiles > ListBoxItem:selected /template/ Border#Check">
    <Setter Property="Opacity" Value="1" />
    <Setter Property="RenderTransform" Value="scale(1)" />
  </Style>

  <Style Selector="ListBox.tiles > ListBoxItem TextBlock.tileTitle">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style Selector="ListBox.tiles > ListBoxItem TextBlock.tileText">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="LineHeight" Value="17" />
    <Setter Property="Foreground" Value="{StaticResource DimTextBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style Selector="TextBox.field">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="MinHeight" Value="42" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}" />
    <Setter Property="SelectionBrush" Value="{StaticResource AccentSelectionBrush}" />
  </Style>

  <Style Selector="TextBox.field /template/ Border#PART_BorderElement">
    <Setter Property="BoxShadow" Value="{StaticResource NoFocusRingShadow}" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
        <BrushTransition Property="Background" Duration="0:0:0.15" />
        <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.18" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="TextBox.field:focus-within /template/ Border#PART_BorderElement">
    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
    <Setter Property="Background" Value="{StaticResource FieldBackgroundBrush}" />
    <Setter Property="BoxShadow" Value="{StaticResource FocusRingShadow}" />
  </Style>

  <Style Selector="TextBox.field.mismatch /template/ Border#PART_BorderElement">
    <Setter Property="BorderBrush" Value="{StaticResource DangerOutlineBrush}" />
  </Style>

  <Style Selector="TextBox.field.mismatch:focus-within /template/ Border#PART_BorderElement">
    <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}" />
    <Setter Property="BoxShadow" Value="0 0 0 3 #33F2707B" />
  </Style>

  <Style Selector="TextBox.field StackPanel.fieldActions">
    <Setter Property="Orientation" Value="Horizontal" />
    <Setter Property="Spacing" Value="2" />
    <Setter Property="Margin" Value="0,0,6,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Border.meterSegment">
    <Setter Property="Height" Value="4" />
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="Background" Value="{StaticResource ProgressTrackBrush}" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.24" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector=":is(Panel).strength-danger Border.meterSegment.lit">
    <Setter Property="Background" Value="{StaticResource DangerBrush}" />
  </Style>

  <Style Selector=":is(Panel).strength-warning Border.meterSegment.lit">
    <Setter Property="Background" Value="{StaticResource WarningBrush}" />
  </Style>

  <Style Selector=":is(Panel).strength-good Border.meterSegment.lit">
    <Setter Property="Background" Value="{StaticResource StrengthGoodBrush}" />
  </Style>

  <Style Selector=":is(Panel).strength-strong Border.meterSegment.lit">
    <Setter Property="Background" Value="{StaticResource SuccessBrush}" />
  </Style>

  <Style Selector="ProgressBar">
    <Setter Property="MinHeight" Value="6" />
    <Setter Property="Height" Value="6" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Background" Value="{StaticResource ProgressTrackBrush}" />
    <Setter Property="Foreground" Value="{StaticResource ProgressFillBrush}" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Value" Duration="0:0:0.3" Easing="0.25,0.8,0.25,1" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="Ellipse.spinnerTrack">
    <Setter Property="Stroke" Value="#1FFFFFFF" />
    <Setter Property="StrokeThickness" Value="2.5" />
  </Style>

  <Style Selector="Arc.spinner">
    <Setter Property="Stroke" Value="{StaticResource AccentBrush}" />
    <Setter Property="StrokeThickness" Value="2.5" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StartAngle" Value="-90" />
    <Setter Property="SweepAngle" Value="100" />
    <Style.Animations>
      <Animation Duration="0:0:0.9" IterationCount="Infinite">
        <KeyFrame Cue="0%">
          <Setter Property="RotateTransform.Angle" Value="0" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="RotateTransform.Angle" Value="360" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
</Styles>
